    def test_direct_attribute_writes_do_not_add_history() -> None:
        """Ensure direct script writes skip history accumulation."""
        from posting.session_variables import SessionVariables
    
        var = SessionVariables()
    
        # Direct script write
        var.my_var = 100
    
